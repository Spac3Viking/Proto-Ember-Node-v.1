{
  "name": "proto-ember-node-v1",
  "version": "1.0.0",
  "description": "Ember Node v.1 project",
  "main": "app/server.js",
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "scripts": {
    "start": "node app/server.js",
    "dev": "nodemon app/server.js",
    "test": "jest",
    "installer:icon": "node installer/windows/generate-installer-icon.js",
    "installer:windows": "node -e \"const { execSync } = require('child_process'); const v = require('./package.json').version; execSync('npm run installer:icon', { stdio: 'inherit' }); execSync('makensis /DAPP_VERSION=' + v + ' installer/windows/Ember-Node-Installer.nsi', { stdio: 'inherit' });\""
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.18.0",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
