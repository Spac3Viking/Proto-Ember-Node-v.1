{
  "id": "ember-node-windows",
  "title": "Ember Node for Windows",
  "version": "0.1.0",
  "last_updated": "2026-04-30",
  "type": "desktop-app",
  "platform": "windows",
  "includes": {
    "portable_node_runtime": true,
    "canonical_offline_packages": [
      {
        "id": "green-fire-core-cache",
        "version": "1.0.0"
      },
      {
        "id": "green-fire-library",
        "version": "2.0.0"
      }
